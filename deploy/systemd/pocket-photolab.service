[Unit]
Description=Pocket Photo Lab — edit your pictures
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-photolab
Group=pocket-photolab
ExecStart=/usr/local/bin/pocket-photolab
Environment=DATA_DIR=/var/lib/pocket-photolab
Environment=PORT=8080
Environment=BASE_URL=https://photolab.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-photolab
PrivateTmp=true

[Install]
WantedBy=multi-user.target
